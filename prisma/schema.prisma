// ============================================================
// L10 Meetings
// ============================================================

model Meeting {
  id              String        @id @default(cuid())
  title           String
  date            DateTime
  status          MeetingStatus @default(scheduled)
  currentSection  Int           @default(0)
  rating          Float?
  notes           String?       @db.Text
  headlines       String?       @db.Text
  segueNotes      String?       @db.Text
  concludeNotes   String?       @db.Text
  cascadeMessages String?       @db.Text
  serviceIds      String[] // IDs of services scoped to this meeting
  rockIds         String[] // IDs of rocks linked to this meeting
  // 2026-07-28: Leadership (L10) meeting. Drives the To-Do Review filter —
  // a leadership meeting only surfaces todos owned by attendees whose role
  // is in LEADERSHIP_MEETING_ROLES (owner/admin/marketing/eos), so a
  // centre educator's todos never appear in the leadership agenda.
  isLeadership    Boolean       @default(false)
  // 2026-07-28: which Scorecard this meeting reviews. Null = fall back to
  // the legacy single scorecard (/api/scorecard), so every pre-existing
  // meeting keeps working untouched.
  scorecardId     String?
  // 2026-07-05 (draft-first L10): AI-prepared agenda — proposed IDS
  // order, scorecard commentary, rock suggestions. Generated by
  // POST /api/meetings/[id]/prepare or the morning-briefing cron for
  // same-day meetings. Null until prepared; facilitators can regenerate.
  aiAgendaDraft   Json?
  aiAgendaDraftAt DateTime?
  // 2026-08-31: completion-time snapshot of meeting outcomes (todos done,
  // issues solved, rock statuses). Written ONCE when the meeting completes
  // so past meetings stop mutating as live data changes. Null = legacy
  // meeting; the UI falls back to live computation.
  outcomes        Json?
  // 2026-08-31: recurring series this occurrence belongs to.
  seriesId        String?
  series          MeetingSeries? @relation("SeriesMeetings", fields: [seriesId], references: [id], onDelete: SetNull)
  startedAt       DateTime?
  completedAt     DateTime?
  createdById     String?
  createdBy       User?         @relation("MeetingCreator", fields: [createdById], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  cascades   CascadeMessage[]   @relation("MeetingCascade")
  attendees  MeetingAttendee[]  @relation("MeetingAttendees")
  todos      Todo[]             @relation("MeetingTodos")
  recordings MeetingRecording[] @relation("MeetingRecordings")

  @@index([date])
  @@index([status])
  @@index([createdById])
  @@index([seriesId])
}

// ── Meeting series (execution layer, 2026-08-31) ────────────────────────
// Recurring meeting template. A daily cron materialises the next
// occurrence as a `scheduled` Meeting, which the morning-briefing cron
// then auto-preps on the day. Wall-clock time is anchored to an IANA
// timezone so DST never shifts the meeting.
model MeetingSeries {
  id              String   @id @default(cuid())
  name            String // e.g. "Leadership L10"
  /// 0=Sunday … 6=Saturday, in the series' local timezone
  dayOfWeek       Int
  /// Minutes from local midnight (13:30 → 810)
  minuteOfDay     Int
  timezone        String   @default("Australia/Sydney")
  isLeadership    Boolean  @default(false)
  serviceIds      String[]
  scorecardId     String?
  attendeeUserIds String[]
  active          Boolean  @default(true)
  createdById     String?
  createdBy       User?    @relation("SeriesCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  meetings Meeting[] @relation("SeriesMeetings")

  @@index([active])
}

enum AttendeeStatus {
  present
  absent
}

// ── Meeting recordings (Phase 2, 2026-08-31) ────────────────────────────
// Audio (browser mic or uploaded Teams/Zoom file) → Deepgram diarized
// transcription (webhook callback) → Claude structured review. The raw
// audio blob is DELETED immediately after successful transcription — the
// transcript is the durable record (privacy decision, see spec).

enum MeetingRecordingStatus {
  uploaded // blob stored, transcription requested
  transcribing // Deepgram accepted the request
  transcribed // transcript stored, audio deleted, summarisation running
  complete // aiReview stored
  failed // error recorded; audio deleted if still present
}

enum MeetingRecordingSource {
  live_mic
  upload
}

model MeetingRecording {
  id                String                 @id @default(cuid())
  meetingId         String
  meeting           Meeting                @relation("MeetingRecordings", fields: [meetingId], references: [id], onDelete: Cascade)
  source            MeetingRecordingSource
  status            MeetingRecordingStatus @default(uploaded)
  audioBlobUrl      String? // nulled after post-transcription deletion
  durationSeconds   Int?
  deepgramRequestId String? // request_id echoed in the webhook callback
  transcript        Json? // utterances: [{ speaker, start, end, text }]
  transcriptText    String?                @db.Text // "Speaker N: ..." rendering
  aiReview          Json? // MeetingAiReview (summary, action items, missed items)
  /// Post-review digest sent to attendees (guarded claim — one send ever).
  digestSentAt      DateTime?
  error             String?
  createdById       String?
  createdBy         User?                  @relation("RecordingCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([meetingId])
  @@index([status, createdAt])
  @@index([deepgramRequestId])
}

model MeetingAttendee {
  id        String         @id @default(cuid())
  meetingId String
  meeting   Meeting        @relation("MeetingAttendees", fields: [meetingId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation("UserMeetingAttendance", fields: [userId], references: [id], onDelete: Cascade)
  status    AttendeeStatus @default(present)
  rating    Int?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([meetingId, userId])
  @@index([meetingId])
  @@index([userId])
}

