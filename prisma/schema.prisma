enum ChildDocumentType {
  ANAPHYLAXIS_PLAN
  ASTHMA_PLAN
  MEDICAL_CERTIFICATE
  IMMUNISATION_RECORD
  COURT_ORDER
  OTHER
}

model ChildDocument {
