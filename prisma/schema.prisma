  docType    String // immunisation, medical_action_plan, birth_certificate, custody_order, other
  fileName   String
  fileUrl    String
  uploadedAt DateTime      @default(now())
  expiryDate DateTime?     @db.Date
  notes      String?       @db.Text

  @@index([childId])
  @@index([contactId])
