  acknowledgedAt DateTime    @default(now())

  @@unique([snippetId, userId])
  @@index([snippetId])
  @@index([userId])
}

// ============================================================
// Enrolment Submissions (Public parent enrolment form)
// ============================================================

model EnrolmentSubmission {
  id        String  @id @default(cuid())
  token     String  @unique @default(cuid())
  enquiryId String?
  serviceId String?

  // Phase 1+2: Family data
  primaryParent   Json // { firstName, surname, dob, email, mobile, address, relationship, occupation, workplace, workPhone, crn }
  secondaryParent Json? // same structure
  children        Json // [{ firstName, surname, dob, gender, address, cultural, school, yearLevel, crn, medical, dietary, bookingPrefs }]

  // Phase 4: Emergency & authorised persons
  emergencyContacts Json // [{ name, relationship, phone, email }]
  authorisedPickup  Json? // [{ name, relationship }]

  // Phase 5: Consents
  consents Json // { firstAid, medication, ambulance, transport, excursions, photos, sunscreen }

  // Phase 7: Payment (masked for security)
  paymentMethod  String? // "credit_card" or "bank_account"
  paymentDetails Json? // { lastFour, cardType } or { bsbLastThree, accountLastFour } — MASKED

  // Phase 8: Submission
  referralSource       String?
  /// 2026-08-03 (Ambassadors): free-text answer to "Which educator spoke
  /// with you?" — shown when referralSource is the educator option.
  referralEducatorName String?
  signature            String? @db.Text
  termsAccepted        Boolean @default(false)
  privacyAccepted      Boolean @default(false)
  debitAgreement       Boolean @default(false)

  // Court orders
  courtOrders     Boolean @default(false)
  courtOrderFiles Json? // [{ filename, url }]

  // Medical uploads
  medicalFiles Json? // [{ childIndex, type, filename, url }]

  // Document uploads (child photos, birth certificates, immunisation records)
  documentUploads Json? // [{ childIndex, type, filename, url }]

  // Status
  status        String    @default("submitted")
  processedById String?
  processedAt   DateTime?
  pdfUrl        String?
  notes         String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  childRecords Child[]

  ambassadorRecords AmbassadorEnrolment[] @relation("AmbassadorFromSubmission")

  @@index([status])
  @@index([enquiryId])
  @@index([token])
}

// ============================================================
// Children (structured records from enrolment submissions)
// ============================================================

model Child {
  // 2026-08-03: why this child sits at THIS service. A child enrolled at
  // two centres has two Child rows, and without this the second one looks
  // like a duplicate or a mistake. Null = ordinary term care.
  // Values: holiday_quest | sibling_campus | casual | transferring | other
  placementReason       String?
  id                    String               @id @default(cuid())
  enrolmentId           String?
  enrolment             EnrolmentSubmission? @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  serviceId             String?
  service               Service?             @relation("ServiceChildren", fields: [serviceId], references: [id])
  firstName             String
  surname               String
  dob                   DateTime?
  gender                String?
  address               Json? // { street, suburb, state, postcode }
  culturalBackground    String[]
  schoolName            String?
  yearLevel             String?
  crn                   String?
  countryOfBirth        String? // "Australia" | "New Zealand" | free text for "Other"
  medical               Json? // Full medical info (legacy — from enrolment import)
  dietary               Json? // Dietary requirements (legacy — from enrolment import)
  bookingPrefs          Json? // Session types, days, booking type
  // ── Expanded profile fields ──
  medicalConditions     String[] // e.g. ["Asthma", "Anaphylaxis"]
  medicationDetails     String? // Free text: medications, dosage, administration
  anaphylaxisActionPlan Boolean              @default(false) // Flag: action plan document exists
  dietaryRequirements   String[] // e.g. ["Halal", "Nut Free", "Vegetarian"]
  additionalNeeds       String? // Free text: other care requirements
  // ── Medicare + immunisation (consumed by Services Medical tab) ──
  medicareNumber        String?
  medicareExpiry        DateTime?
  medicareRef           String?
  vaccinationStatus     String?
  nextImmunisationDue   DateTime?            @db.Date
  // ── Custody / guardianship (admin-set, surfaced on sign-out + medical) ──
  custodyArrangements   Json? // { type: "shared" | "sole" | "court_order" | "informal", primaryGuardian?, details?, courtOrderUrl? }
  // ── CCS + room + tags (first-class filter dimensions, 4b) ──
  ccsStatus             String? // "eligible" | "pending" | "ineligible" — documented values, free-text for forward compat
  room                  String? // dashboard-controlled room label; decoupled from OWNA's ownaRoomName
  tags                  String[]             @default([]) // optional filter tags; empty-array default means existing rows don't need backfill
  photo                 String? // URL to profile photo (Vercel Blob)

  // ── OSHC enrolment record (2026-07-31) ───────────────────────────────
  // Modelled on the fields OWNA collects, trimmed to what school-age care
  // actually needs. Toileting and sleep-check were deliberately NOT
  // carried over — they're under-24-month concerns and meaningless here.
  preferredName             String? // what educators actually call them
  livesWith                 String? // "Both parents", "Mother", shared care…
  // Reg 160(3)(h)-(i): language and cultural background of the child.
  mainLanguageAtHome        String?
  languagesOtherThanEnglish String?
  englishAssistance         Boolean @default(false)
  // Collected for reporting; "Neither" is a real answer, so null means
  // "not asked yet" rather than "no".
  indigenousStatus          String?
  yearOfArrival             Int? // if not born in Australia
  // Drives the staff discount, so it's a billing input, not just a note.
  isStaffChild              Boolean @default(false)
  // ── Posting / consent preferences ──
  suppressBirthdayPost      Boolean @default(false)
  ownSunscreen              Boolean @default(false)
  noAppPosting              Boolean @default(false)
  allowSocialMediaPost      Boolean @default(false)

  status       String    @default("pending") // pending, active, withdrawn
  // OWNA sync fields
  ownaChildId  String?   @unique
  ownaRoomId   String?
  ownaRoomName String?
  ownaSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  bookings           Booking[]             @relation("ChildBookings")
  absences           Absence[]             @relation("ChildAbsences")
  documents          ParentDocument[]      @relation("ChildDocuments")
  childDocuments     ChildDocument[]       @relation("ChildProfileDocuments")
  authorisedPickups  AuthorisedPickup[]    @relation("ChildPickups")
  postTags           ParentPostChildTag[]  @relation("ChildPostTags")
  formSignatures     ParentFormSignature[] @relation("ChildFormSignatures")
  illnessRecords     IllnessRecord[]       @relation("ChildIllnessRecords")
  discounts          FamilyDiscount[]      @relation("ChildDiscounts")
  attendanceRecords  AttendanceRecord[]    @relation("ChildAttendance")
  statementLineItems StatementLineItem[]   @relation("ChildStatementLines")
  feeAssignments     ChildFeeAssignment[]  @relation("ChildFeeAssignments")

  // ── NQS relations ─────────────────────────────────
  observations  LearningObservation[]      @relation("ChildObservations")
  medications   MedicationAdministration[] @relation("ChildMedications")
  allAboutMe    AllAboutMe?                @relation("ChildAllAboutMe")
  feedbackItems ParentFeedback[]           @relation("ChildFeedback")

  // ── Regulatory records (2026-08-09) ───────────────
  incidents    IncidentRecord[]   @relation("ChildIncidents")
  medicalPlans ChildMedicalPlan[] @relation("ChildMedicalPlans")
  complaints   ComplaintRecord[]  @relation("ChildComplaints")

  ambassadorRecords AmbassadorEnrolment[] @relation("AmbassadorChild")

  @@index([enrolmentId])
  @@index([serviceId])
  @@index([status])
  @@index([ownaChildId])
  @@index([serviceId, ccsStatus])
  @@index([serviceId, room])
  @@index([serviceId, nextImmunisationDue])
}

// ── All About Me (Amana Way stage 5 — Reassurance) ───────────
//
// Parent-portal form filled before first session. Surfaces to staff
// on the child's roll-call card so they can greet the child with
// the right context (nickname, favourite foods, calming techniques).

model AllAboutMe {
  id                String    @id @default(cuid())
  childId           String    @unique
  child             Child     @relation("ChildAllAboutMe", fields: [childId], references: [id], onDelete: Cascade)
  nickname          String?
  favouriteFood     String?
  favouriteToys     String?
  favouriteSubjects String?
  hobbies           String?
  fears             String?
  calmingTechniques String?   @db.Text
  additionalNotes   String?   @db.Text
  submittedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([childId])
}

// ── Sequences (Parent Nurture + CRM Outreach) ───────────────

enum SequenceType {
  parent_nurture
  crm_outreach
}

model Sequence {
  id           String       @id @default(cuid())
  name         String
  type         SequenceType
  triggerStage String? // enquiry stage (info_sent, nurturing, etc.) or PipelineStage (new_lead, etc.)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  steps      SequenceStep[]
  enrolments SequenceEnrolment[]

  @@unique([name, type])
  @@index([type])
  @@index([triggerStage])
}

model SequenceStep {
  id              String         @id @default(cuid())
  sequenceId      String
  sequence        Sequence       @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  stepNumber      Int
  name            String
  delayHours      Int // hours after anchor date (negative = before)
  templateKey     String // backward-compat key (e.g. "nudge_1", "ccs_assist")
  emailTemplateId String? // FK to EmailTemplate for visual template override
  emailTemplate   EmailTemplate? @relation("StepEmailTemplate", fields: [emailTemplateId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  executions SequenceStepExecution[]

  @@unique([sequenceId, stepNumber])
  @@index([sequenceId])
}

model SequenceEnrolment {
  id                String         @id @default(cuid())
  sequenceId        String
  sequence          Sequence       @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  contactId         String? // for parent nurture
  contact           CentreContact? @relation("ContactSequenceEnrolments", fields: [contactId], references: [id])
  leadId            String? // for CRM outreach
  lead              Lead?          @relation("LeadSequenceEnrolments", fields: [leadId], references: [id])
  enquiryId         String?
  serviceId         String?
  status            String         @default("active") // active, paused, completed, cancelled
  currentStepNumber Int            @default(1)
  anchorDate        DateTime       @default(now())
  enrolledAt        DateTime       @default(now())
  completedAt       DateTime?
  pausedAt          DateTime?

  executions SequenceStepExecution[]

  @@unique([sequenceId, contactId])
  @@unique([sequenceId, leadId])
  @@index([sequenceId])
  @@index([status])
}

model SequenceStepExecution {
  id           String            @id @default(cuid())
  enrolmentId  String
  enrolment    SequenceEnrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  stepId       String
  step         SequenceStep      @relation(fields: [stepId], references: [id], onDelete: Cascade)
  scheduledFor DateTime
  sentAt       DateTime?
  status       String            @default("pending") // pending, sent, failed, cancelled
  error        String?
  attempts     Int               @default(0) // failed send attempts; capped before marking "failed"
  createdAt    DateTime          @default(now())

  @@index([status, scheduledFor])
  @@index([enrolmentId])
}

// ── Parent Portal ───────────────────────────────────────────

// ─── Parent accounts (2026-07-30) ────────────────────────────────────
//
// Phase 1 of the enrolment re-architecture. Previously parents had NO
// account: they submitted an anonymous enrolment and were identified
// afterwards by scanning EnrolmentSubmission JSON for their email.
// Now the account exists FIRST and owns everything that follows.
//
// Login is password-primary with the existing magic link kept as the
// forgot-password path, so a parent can never be locked out of their
// own enrolment.
model ParentAccount {
  id                        String    @id @default(cuid())
  // Always stored lowercased+trimmed — the lookup path depends on it.
  email                     String    @unique
  passwordHash              String
  // Null until the parent clicks the emailed confirmation link. Gates
  // login: an unverified account cannot start an enrolment.
  emailVerifiedAt           DateTime?
  // Captured at sign-up so we can address them in the confirmation email
  // before any enrolment data exists.
  firstName                 String?
  surname                   String?
  // Set when an existing family claims their pre-account enrolments, so
  // the one-time backfill is auditable and never re-runs.
  claimedAt                 DateTime?
  lastLoginAt               DateTime?
  // 2026-07-30: when staff last nudged this family to finish their
  // enrolment. Stored so the Families list can show "reminded 2 days ago"
  // and staff don't unknowingly send the same parent three emails.
  enrolmentReminderSentAt   DateTime?
  // 2026-08-03: staff can switch a family's portal access off without
  // deleting them. Deleting loses the enrolment history and the billing
  // arrangement; a family who leaves, or who is in dispute, needs the
  // access gone but the record kept. Null = active.
  // 2026-08-04: the "Add Amana to your phone" card on the portal home.
  // Against the ACCOUNT, not localStorage — a parent who dismisses it on
  // their phone shouldn't meet it again on the tablet.
  appInstallCardDismissedAt DateTime?
  deactivatedAt             DateTime?
  deactivatedById           String?
  deactivatedReason         String?

  // ── Family identity ──────────────────────────────────────────────────
  // 2026-07-31: the household's name, taken from the PRIMARY carer's
  // surname when they submit their enrolment. Stored rather than derived
  // so staff can correct it — blended families, hyphenated names and
  // parents with different surnames to their children are all normal, and
  // guessing wrong every time you render the list is worse than storing
  // it once.
  familyName String?

  // ── Billing arrangement ──────────────────────────────────────────────
  // Kept on the account rather than a separate model: the family IS the
  // billing entity here, and a one-to-one table would be indirection with
  // no second owner.
  billingFrequency  String? // "weekly" | "fortnightly" | "monthly"
  // Day the debit falls. 1-7 (Mon-Sun) for weekly/fortnightly, 1-28 for
  // monthly — capped at 28 so a February billing date always exists.
  billingAnchorDay  Int?
  // Optional ceiling per debit, in CENTS. Integer on purpose: floats and
  // money don't mix, and this figure is compared against real charges.
  billingLimitCents Int?
  billingNotes      String? @db.Text

  // ── Invoicing schedule ───────────────────────────────────────────────
  // Modelled on what OWNA exposes, because that's the shape the office
  // already reasons in. Daniel: "billing day, and then starting week of —
  // e.g. starting from the week of 3 April, the billing date would be the
  // 13th." A weekday alone can't express that, so the cycle is anchored to
  // real DATES: which period it covers, when the next invoice goes out,
  // and how many weeks each cycle spans.
  //
  // Anything before this is ignored when generating invoices.
  billingStartDate     DateTime? @db.Date
  // The period the NEXT invoice covers, and when it is raised.
  billingPeriodStart   DateTime? @db.Date
  nextBillingDate      DateTime? @db.Date
  // Weeks per invoice cycle (1 = weekly, 2 = fortnightly, 4 = monthly-ish).
  billingWeeks         Int?
  // Inverted from OWNA's "Do NOT Auto Invoice" so the default is the safe,
  // expected behaviour rather than depending on a false meaning "on".
  autoInvoice          Boolean   @default(true)
  // Suspends the debit without losing the arrangement — a payment plan or
  // a family in hardship, where deleting the setup would lose the history.
  pauseDebiting        Boolean   @default(false)
  // Staff follow-up, surfaced in the communication diary.
  billingReminderDate  DateTime? @db.Date
  billingReminderNotes String?   @db.Text
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  verifications  ParentEmailVerification[]
  enrolmentDraft EnrolmentDraft?

  /// 2026-08-03 (Ambassadors): educator ref code captured from
  /// /parent/signup?ref= — validated against EducatorRefCode at signup,
  /// resolved into attribution when an enrolment is submitted.
  ambassadorRefCode String?

  @@index([email])
}

// Single-use, hashed email-confirmation tokens. Mirrors ParentMagicLink's
// shape deliberately: only the hash is stored, so a database leak cannot
// be replayed to verify someone else's address.
model ParentEmailVerification {
  id        String        @id @default(cuid())
  accountId String
  account   ParentAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([accountId])
  @@index([tokenHash])
}

// ─── Enrolment draft (2026-07-30, Phase 2) ───────────────────────────
//
// A parent's in-progress enrolment, owned by their account. Separate from
// EnrolmentSubmission on purpose: a submission is a completed, immutable
// record staff act on, whereas this is scratch state that changes on every
// keystroke. Mixing them would mean half-filled rows appearing in the
// staff enrolment queue.
//
// One draft per account (@unique on accountId) — a parent completes one
// enrolment at a time, adding multiple children within it.
//
// `data` is the whole form blob rather than columns because the shape is
// still moving; it's validated on SUBMIT, not on autosave. Autosave must
// never reject a half-typed field — losing a parent's work to a validation
// error they can't see is worse than storing something incomplete.
model EnrolmentDraft {
  id          String        @id @default(cuid())
  accountId   String        @unique
  account     ParentAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // Which step they were last on, so "continue where you left off" lands
  // them in the right place rather than back at step 1.
  currentStep Int           @default(0)
  data        Json          @default("{}")
  submittedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([accountId])
}

model ParentMagicLink {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([tokenHash])
}

model Booking {
  id            String         @id @default(cuid())
  childId       String
  child         Child          @relation("ChildBookings", fields: [childId], references: [id], onDelete: Cascade)
  serviceId     String
  service       Service        @relation("ServiceBookings_Portal", fields: [serviceId], references: [id], onDelete: Cascade)
  date          DateTime       @db.Date
  sessionType   SessionType
  /// Stage 1 dual key: the room this row belongs to, resolved from
  /// (serviceId, sessionType). Nullable while both keys are written —
  /// see docs/rooms-migration-plan.md.
  roomId        String
  room          Room          @relation("RoomBooking", fields: [roomId], references: [id], onDelete: Restrict)
  status        BookingStatus  @default(requested)
  type          BookingType    @default(casual)
  fee           Float?
  ccsApplied    Float? // CCS subsidy amount applied
  gapFee        Float? // Fee after CCS applied
