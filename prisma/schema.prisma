  illnessRecords  IllnessRecord[]       @relation("ServiceIllnessRecords")
  sessionTimeList ServiceSessionTime[]  @relation("ServiceSessionTimes")
  medicalPlans    ChildMedicalPlan[]    @relation("ServiceMedicalPlans")
  complaints      ComplaintRecord[]     @relation("ServiceComplaints")
  blockOutDates   ServiceBlockOutDate[] @relation("ServiceBlockOutDates")
  casualDays      CasualDayConfig[]     @relation("ServiceCasualDays")
