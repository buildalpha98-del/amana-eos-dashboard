// ═══════════════════════════════════════════════════════════
// QIP / SAT DOCUMENT MANAGEMENT
// ═══════════════════════════════════════════════════════════

model QualityImprovementPlan {
  id             String           @id @default(cuid())
  serviceId      String           @unique
  service        Service          @relation("ServiceQIP", fields: [serviceId], references: [id])
  state          String
  documentType   String           @default("qip") // qip | sat
  status         String           @default("draft") // draft | in_review | current | archived
  /// Document-level service philosophy statement (first section of the NSW SAT form).
  servicePhilosophy String?       @db.Text
  /// Per-QA comments for the Law & Regulations checklist: { "1": "...", ... }
  legalComments  Json?
  lastReviewDate DateTime?
  reviewedById   String?
  reviewedBy     User?            @relation("QIPReviewer", fields: [reviewedById], references: [id])
  qualityAreas   QIPQualityArea[]
  elements       SatElementAssessment[]
  legalChecks    SatLegalCheck[]
  improvements   SatImprovement[]
  suggestions    QipSuggestion[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

/// Per-NQS-element assessment: the core of the official SAT/QIP structure.
/// One row per element (40 per document); the fixed taxonomy (concept,
/// description, standard) lives in src/lib/nqs-taxonomy.ts, only per-service
/// content lives here. `evidence` holds up to 5 "Evidence and Key practices"
/// entries, mirroring the NSW form's five text boxes.
model SatElementAssessment {
  id          String                 @id @default(cuid())
  qipId       String
  qip         QualityImprovementPlan @relation(fields: [qipId], references: [id], onDelete: Cascade)
  elementCode String // "1.1.1" … "7.2.3"
  evidence    String[]               @default([])
  assessment  String                 @default("not_assessed") // not_assessed | met | not_met
  updatedAt   DateTime               @updatedAt

  @@unique([qipId, elementCode])
}

/// Per-QA Law & Regulations checklist answers (questions are fixed taxonomy).
model SatLegalCheck {
  id         String                 @id @default(cuid())
  qipId      String
  qip        QualityImprovementPlan @relation(fields: [qipId], references: [id], onDelete: Cascade)
  checkKey   String // taxonomy key, e.g. "qa1-01"
  assessment String                 @default("not_assessed") // not_assessed | compliant | non_compliant | not_applicable
  updatedAt  DateTime               @updatedAt

  @@unique([qipId, checkKey])
}

/// Continuous Improvement Opportunities rows (per element/standard), matching
/// the NSW SAT form's improvement table.
model SatImprovement {
  id             String                 @id @default(cuid())
  qipId          String
  qip            QualityImprovementPlan @relation(fields: [qipId], references: [id], onDelete: Cascade)
  elementCode    String // element ("1.1.1") or standard ("1.1") ref
  issue          String                 @db.Text
  outcomeGoal    String                 @db.Text
  priority       String                 @default("medium") // low | medium | high
  steps          String                 @db.Text
  successMeasure String                 @db.Text
  byWhen         String?
  progressNotes  String?                @db.Text
  status         String                 @default("not_started") // not_started | in_progress | completed
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([qipId, status])
}

model QIPQualityArea {
  id                  String                 @id @default(cuid())
  qipId               String
  qip                 QualityImprovementPlan @relation(fields: [qipId], references: [id], onDelete: Cascade)
  qualityArea         Int // 1-7
  qualityAreaName     String
  strengths           String?                @db.Text
  areasForImprovement String?                @db.Text
  improvementGoal     String?                @db.Text
  strategies          String?                @db.Text
  timeline            String?
  responsiblePerson   String?
  evidenceIndicators  String?                @db.Text
  evidenceCollected   String?                @db.Text
  progressNotes       String?                @db.Text
  progressStatus      String                 @default("not_started") // not_started | in_progress | achieved | ongoing
  updatedAt           DateTime               @updatedAt

  @@unique([qipId, qualityArea])
}

/// AI-proposed SAT/QIP updates awaiting director review. Rows are never
/// deleted — accepted/edited/rejected rows are the audit trail of what
/// changed, when, on what evidence, approved by whom.
model QipSuggestion {
  id           String                 @id @default(cuid())
  qipId        String
  qip          QualityImprovementPlan @relation(fields: [qipId], references: [id], onDelete: Cascade)
  qualityArea  Int // 1-7
  /// Target NQS element for evidence suggestions ("1.1.1"). Null on legacy
  /// per-QA-field rows created before the element-level restructure.
  elementCode  String?
  field        String // "evidence" (element-level) | legacy: "strengths" | "areasForImprovement" | "progressNotes" | "evidenceCollected"
  currentText  String?                @db.Text
  proposedText String                 @db.Text
  rationale    String                 @db.Text
  evidenceRefs Json // [{ type: "reflection"|"observation", id, excerpt }]
  status       String                 @default("pending") // pending | accepted | edited | rejected
  reviewedById String?
  reviewedBy   User?                  @relation("QipSuggestionReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  weekOf       DateTime // Monday 00:00 Australia/Sydney of the evidence week
  createdAt    DateTime               @default(now())

  @@index([qipId, status])
  @@index([weekOf])
}

// ═══════════════════════════════════════════════════════════
// INCIDENT TRACKING & TREND ANALYSIS
// ═══════════════════════════════════════════════════════════

/// The incident, injury, trauma and illness record — Regulation 87.
///
/// The original model was a trend-analysis table: enough to count injuries
/// by location, nowhere near enough to be the record Reg 87 actually
/// prescribes. Reg 87(2) lists the entries by name, and an authorised
/// officer reads that list literally. The 2026-08-09 columns below close
/// it: witnesses, first aid and who gave it, medical personnel contacted,
/// and — the one that gets services in trouble — WHO was notified and at
/// WHAT TIME, because Reg 86 gives you 24 hours from becoming aware and a
/// bare `parentNotified` boolean can't prove you met it.
///
/// `sharedWithParentAt` is the gate for the family's copy in the parent
/// portal. It is deliberately separate from `parentNotifiedAt`: notifying
/// a parent is a phone call at the time, publishing the written record is
/// a later, considered act. A behaviour incident naming another child
/// must never auto-publish, so nothing reaches a parent until a human
/// sets this.
model IncidentRecord {
  id            String   @id @default(cuid())
  serviceId     String
  service       Service  @relation("ServiceIncidents", fields: [serviceId], references: [id])
  incidentDate  DateTime
  childName     String?
  /// Linked child, where the record is about one. Kept ALONGSIDE
  /// childName (not replacing it) so the record still reads correctly
  /// after the child leaves and the row is set null.
  childId       String?
  child         Child?   @relation("ChildIncidents", fields: [childId], references: [id], onDelete: SetNull)
  /// Reg 87(2)(a) wants the age, and "age today" is the wrong answer on a
  /// record read two years later — so it is stamped, not derived.
  childAge      Int?
  incidentType  String // injury | illness | behaviour | missing_child | near_miss | medication_error | property_damage | complaint
  severity      String // minor | moderate | reportable | serious
  location      String? // indoor | outdoor | playground | transition | bathroom | kitchen
  timeOfDay     String? // arrival | programme | meal_time | packdown | departure
  description   String   @db.Text
  /// Reg 87(2)(b): the circumstances LEADING UP TO it, which is a
  /// different question from what happened and is the one most often
  /// left blank.
  circumstances String?  @db.Text
  actionTaken   String?  @db.Text

  // ── Reg 87(2)(d)-(e): first aid and medical response ──────────────
  firstAidGiven             Boolean @default(false)
  /// Free text rather than a user FK: first aid is often given by a
  /// casual or a visiting parent who has no dashboard account.
  firstAidBy                String?
  firstAidDetails           String? @db.Text
  /// Reg 87(2)(e): "details of any medical personnel contacted" —
  /// ambulance, GP, hospital, poisons line.
  medicalPersonnelContacted String? @db.Text
  ambulanceCalled           Boolean @default(false)

  /// Reg 87(2)(f): who saw it happen. Names, free text — a witness is
  /// frequently a child or a passer-by.
  witnesses String? @db.Text

  // ── Reg 86: notification of the family ────────────────────────────
  parentNotified       Boolean   @default(false)
  /// The timestamp Reg 86's 24-hour obligation is measured against.
  parentNotifiedAt     DateTime?
  /// Reg 87(2)(g) asks for the name of the person notified — which is
  /// not always the enrolled parent (grandparent, emergency contact).
  parentNotifiedName   String?
  /// phone | in_person | email | sms | portal | attempted_no_answer.
  /// The last value matters: Reg 87(2)(g) counts an ATTEMPT as an entry.
  parentNotifiedMethod String?
  parentNotifiedById   String?
  parentNotifiedBy     User?     @relation("IncidentParentNotifier", fields: [parentNotifiedById], references: [id], onDelete: SetNull)

  // ── The family's copy in the parent portal ────────────────────────
  sharedWithParentAt      DateTime?
  sharedById              String?
  sharedBy                User?     @relation("IncidentSharer", fields: [sharedById], references: [id], onDelete: SetNull)
  /// Typed-name signature, same convention as ParentFormSignature.
  parentAcknowledgedAt    DateTime?
  parentAcknowledgedName  String?
  parentAcknowledgedEmail String?

  // ── Reg 176(2)(a): telling the Regulatory Authority ───────────────
  reportableToAuthority   Boolean   @default(false)
  /// Reg 12's closed list, so the 24-hour vs 7-day question can be
  /// answered from the record: death | serious_injury | serious_illness |
  /// missing_child | unauthorised_removal | locked_in_or_out.
  seriousIncidentCategory String?
  /// The clock starts when the service BECAME AWARE, which can be days
  /// after the incident date. Reg 176 is explicit about this.
  becameAwareAt           DateTime?
  reportedToAuthorityAt   DateTime?
  /// NQA ITS notification reference, so the register proves the lodgement.
  authorityReference      String?

  followUpRequired  Boolean  @default(false)
  followUpCompleted Boolean  @default(false)
  ownaIncidentId    String?
  createdById       String?
  createdBy         User?    @relation("IncidentCreator", fields: [createdById], references: [id])
  /// Reg 87(2)(h): the name and signature of the person making the entry.
  /// createdBy gives the account; this gives the signature they typed.
  recordedSignature String?
  deleted           Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Workers compensation claim that may stem from this incident.
  // SetNull on the FK in the back-relation so an incident can be
  // deleted without taking the WC record with it (the claim is its
  // own legal artifact at that point).
  workersCompClaims WorkersCompensationClaim[] @relation("IncidentWCClaim")

  @@index([serviceId])
  @@index([incidentDate])
  @@index([incidentType])
  @@index([severity])
  /// The parent portal's only query: this child's shared records, newest
  /// first. Without it every parent page load sequentially scans.
  @@index([childId, sharedWithParentAt])
  /// Drives the "notification overdue" surfaces — the outstanding
  /// Reg 176 lodgements, and the Reg 86 24-hour breaches.
  @@index([serviceId, reportableToAuthority, reportedToAuthorityAt])
}

// ============================================================
// Children's Interest Capture (NQS QA1)
// ============================================================

model ChildInterest {
  id                 String           @id @default(cuid())
  serviceId          String
  service            Service          @relation("ServiceInterests", fields: [serviceId], references: [id], onDelete: Cascade)
  capturedDate       DateTime         @default(now())
  childName          String? // optional — can be group-level
  interestTopic      String
  interestCategory   String? // sport/animals/science/art/cooking/technology/nature/social/cultural/religious/other
  source             String // interest_book/verbal/observation/parent/suggestion_box
  capturedById       String?
  capturedBy         User?            @relation("InterestCaptures", fields: [capturedById], references: [id], onDelete: SetNull)
  linkedToActivityId String?
  linkedToActivity   ProgramActivity? @relation("InterestToActivity", fields: [linkedToActivityId], references: [id], onDelete: SetNull)
  actioned           Boolean          @default(false)
  actionedDate       DateTime?
  notes              String?          @db.Text
  createdAt          DateTime         @default(now())

  @@index([serviceId, actioned])
  @@index([serviceId, capturedDate])
}

// ============================================================
// Audit Reviews (NQS Quality Area Evidence Packs)
// ============================================================

model AuditReview {
  id              String         @id @default(cuid())
  auditInstanceId String?
  auditInstance   AuditInstance? @relation("AuditReviews", fields: [auditInstanceId], references: [id], onDelete: SetNull)
  centreId        String
  qualityArea     Int // 1-7 (NQS QA1–QA7)
  elements        Json // Array of { element: string, rating: string, evidence: string }
  overallRating   String // "exceeding" | "meeting" | "working_towards" | "not_met"
  reviewerNotes   String?        @db.Text
  reviewedAt      DateTime       @default(now())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([centreId])
  @@index([qualityArea])
  @@index([centreId, qualityArea])
}

// ============================================================
// Educator Reflections
// ============================================================

enum ReflectionType {
