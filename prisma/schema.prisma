  vendorContact                  VendorContact?            @relation("VendorContactUser")
  whatsappPostsAsCoordinator     WhatsAppCoordinatorPost[] @relation("WhatsAppCoordinator")
  whatsappPostsRecorded          WhatsAppCoordinatorPost[] @relation("WhatsAppRecorder")
