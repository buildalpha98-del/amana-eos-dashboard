  linkLabel   String?
  active      Boolean   @default(true)
  dismissible Boolean   @default(true)
  createdById String?
  startsAt    DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

