  coreValues           String[]
  corePurpose          String?
  coreNiche            String?
  tenYearTarget        String?   @db.Text
  threeYearPicture     String?   @db.Text // legacy freeform — superseded by the threeYear* fields below; rendered read-only until cleared
  threeYearFutureDate  DateTime?
  threeYearRevenue     String?
  threeYearProfit      String?
  threeYearMeasurables String?   @db.Text
  threeYearLooksLike   String?   @db.Text
  oneYearFutureDate    DateTime?
  oneYearRevenue       String?
  oneYearProfit        String?
  oneYearMeasurables   String?   @db.Text
