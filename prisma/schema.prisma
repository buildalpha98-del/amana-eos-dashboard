// ============================================================
// Compliance Calendar
// ============================================================

enum CertificateType {
  wwcc
  first_aid
  anaphylaxis
  asthma
  cpr
  police_check
  annual_review
  child_protection
  geccko
  food_safety
  food_handler
  // Added 2026-06-01 per HR audit:
  // - Annual mandatory-reporter refresher (NSW Children and Young
  //   Persons (Care and Protection) Act 1998 + state equivalents);
  //   OSHC educators are mandatory reporters and FWC / DCJ expect
  //   evidence of yearly training as an aggravating-factor mitigator.
  mandatory_reporter_training
  // - Annual Child Safe Code of Conduct acknowledgement under the
  //   National Principles for Child Safe Organisations (also
  //   Victorian Child Safe Standards 2022, NSW Office of the
  //   Children's Guardian, etc).
  child_safe_code_of_conduct
  other
}

model ComplianceCertificate {
  id                    String                 @id @default(cuid())
  // 2026-06-05: serviceId relaxed to nullable. Personal certs
  // (WWCC, First Aid, Child Safe Code of Conduct, etc.) belong to
  // the individual staff member — they aren't tied to a specific
  // centre. Pre-2026-06 the column was NOT NULL and the upload UI
  // forced session.user.serviceId, which 400'd "Service ID is
  // required" for any staff member without a service assigned.
  // userId is now the only required identity for a personal cert;
  // serviceId is optional and only used by service-level certs.
  serviceId             String?
  service               Service?               @relation("ServiceCertificates", fields: [serviceId], references: [id], onDelete: Cascade)
  userId                String?
  user                  User?                  @relation("UserCertificates", fields: [userId], references: [id], onDelete: SetNull)
  type                  CertificateType
  label                 String?
  issueDate             DateTime
  // Nullable so certs that legitimately never expire (e.g. annual policy
  // ack, induction confirmation) can be modelled as `expiryDate: null`
  // instead of a sentinel far-future date. The expiring-soon warning
  // system treats null as "valid forever".
  expiryDate            DateTime?
  notes                 String?                @db.Text
  fileUrl               String?
  fileName              String?
  alertDays             Int                    @default(30)
  acknowledged          Boolean                @default(false)
  /// Renewal chain — points at the prior certificate this one renews.
  /// `previous.supersededAt` gets set when this cert is created via the renew flow.
  previousCertificateId String?                @unique
  previous              ComplianceCertificate? @relation("CertificateRenewal", fields: [previousCertificateId], references: [id])
  renewedBy             ComplianceCertificate? @relation("CertificateRenewal")
  /// Set on the OLD cert when a successor (renewal) is created.
  supersededAt          DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  alerts ComplianceCertificateAlert[] @relation("CertificateAlerts")

  @@index([serviceId])
  @@index([userId])
  @@index([expiryDate])
}

/// Dedup tracking for compliance expiry alerts. One row per (cert, threshold).
/// Ensures the cron doesn't send duplicate emails on re-runs or retries.
model ComplianceCertificateAlert {
  id            String                @id @default(cuid())
  certificateId String
  certificate   ComplianceCertificate @relation("CertificateAlerts", fields: [certificateId], references: [id], onDelete: Cascade)
  threshold     Int // 30 | 14 | 7 | 0 — which cadence milestone
  sentAt        DateTime              @default(now())
  channels      String[] // "email" | "in_app"

  @@unique([certificateId, threshold])
  @@index([certificateId])
  @@index([sentAt])
}

// ── Attendance & Enrolment Tracking ─────────────────────────

model DailyAttendance {
  id           String      @id @default(cuid())
  serviceId    String
  service      Service     @relation("ServiceAttendance", fields: [serviceId], references: [id], onDelete: Cascade)
  date         DateTime    @db.Date
  sessionType  SessionType
  /// Stage 1 dual key: the room this row belongs to, resolved from
  /// (serviceId, sessionType). Nullable while both keys are written —
  /// see docs/rooms-migration-plan.md.
  roomId       String
  room         Room       @relation("RoomDailyAttendance", fields: [roomId], references: [id], onDelete: Restrict)
  enrolled     Int         @default(0)
  attended     Int         @default(0)
  capacity     Int         @default(0)
  casual       Int         @default(0)
  absent       Int         @default(0)
  notes        String?     @db.Text
  recordedById String?
  recordedBy   User?       @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([serviceId, date, sessionType])

  /// Stage 1 parallel unique. Held AT THE SAME TIME as the

  /// sessionType one above — a resolver bug then fails the write

  /// instead of diverging quietly.

  @@unique([roomId, date], map: "DailyAttendance_roomId_unique_idx")
  @@index([serviceId])
  @@index([date])
  @@index([serviceId, date])
}

model AttendanceRecord {
  id            String      @id @default(cuid())
  childId       String
  child         Child       @relation("ChildAttendance", fields: [childId], references: [id], onDelete: Cascade)
  serviceId     String
  service       Service     @relation("ServiceIndividualAttendance", fields: [serviceId], references: [id], onDelete: Cascade)
  date          DateTime    @db.Date
  sessionType   SessionType
  /// Stage 1 dual key: the room this row belongs to, resolved from
  /// (serviceId, sessionType). Nullable while both keys are written —
  /// see docs/rooms-migration-plan.md.
  roomId        String
  room          Room       @relation("RoomAttendanceRecord", fields: [roomId], references: [id], onDelete: Restrict)
  status        String      @default("booked") // booked, present, absent
  signInTime    DateTime?
  signOutTime   DateTime?
  signedInById  String?
  signedOutById String?
  signedInBy    User?       @relation("SignInRecorder", fields: [signedInById], references: [id], onDelete: SetNull)
  signedOutBy   User?       @relation("SignOutRecorder", fields: [signedOutById], references: [id], onDelete: SetNull)

  // ── Who actually signed (2026-08-01) ─────────────────────────────────
  // signedInById references User, i.e. STAFF. There was no way to record
  // a PARENT or authorised person signing a child in or out — which is
  // what Regulation 158 actually asks for: a record of the person who
  // delivered or collected the child, and their signature.
  //
  // Stored as a name + method rather than a foreign key because the
  // signer is often an authorised pickup person or a grandparent, not
  // anyone with a login.
  signedInByName      String?
  signedOutByName     String?
  // "staff" | "parent_kiosk" | "parent_app"
  signedInMethod      String?
  signedOutMethod     String?
  // Drawn signature, stored as a data URL. Nullable because a kiosk PIN
  // is an acceptable alternative and not every service will use ink.
  signedInSignature   String?   @db.Text
  signedOutSignature  String?   @db.Text
  absenceReason       String?
  notes               String?   @db.Text
  // ── First-day photo SMS (Amana Way stage 5) ──
  firstDayPhotoUrl    String?
  firstDayPhotoSentAt DateTime?
  firstDayPhotoSentTo String? // recipient mobile in E.164 — audit trail
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([childId, serviceId, date, sessionType])

  /// Stage 1 parallel unique. Held AT THE SAME TIME as the

  /// sessionType one above — a resolver bug then fails the write

  /// instead of diverging quietly.

  @@unique([childId, roomId, date], map: "AttendanceRecord_roomId_unique_idx")
  @@index([serviceId, date, sessionType])
  @@index([childId])
}

