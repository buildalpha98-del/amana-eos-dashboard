  /// Stage 1 parallel unique. Held AT THE SAME TIME as the

  /// sessionType one above — a resolver bug then fails the write

  /// instead of diverging quietly.

  @@unique([childId, roomId, date], map: "Booking_roomId_unique_idx")
  @@index([childId])
  @@index([serviceId])
  @@index([date])
  @@index([status])
  @@index([serviceId, date])
  @@index([childId, status])
  @@index([date, status])
  @@index([status, serviceId])
}

model Absence {
  id                    String      @id @default(cuid())
  childId               String
  child                 Child       @relation("ChildAbsences", fields: [childId], references: [id], onDelete: Cascade)
