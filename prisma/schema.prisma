  phone       String?
  email       String?
  notes       String?           @db.Text
  startedAt   DateTime?
  pausedAt    DateTime?
  pauseReason String?           @db.VarChar(500)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status])
  @@index([role])
