  uploadedBy   User              @relation("UploadedChildDocuments", fields: [uploadedById], references: [id])
  uploaderType String? // "staff" | "parent"
  expiresAt    DateTime?
  isVerified   Boolean           @default(false)
  verifiedById String?
  verifiedAt   DateTime?
  notes        String?           @db.Text
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @default(now()) @updatedAt

  @@index([childId])
  @@index([uploadedById])
}

/// Regulation 90 — the three plans a child with a medical condition must
/// have, and the one thing the dashboard could not previously hold.
///
/// Before this, a child's anaphylaxis was `medicalConditions: ["Anaphylaxis"]`
/// plus `anaphylaxisActionPlan: true` — a string in an array and a boolean.
/// That records that a plan EXISTS somewhere; it is not the plan. Reg 90(1)(c)
/// asks for three distinct documents per condition and assessors ask for all
/// three by name:
///
///   (i)   the medical management plan, signed by a registered medical
///         practitioner — an upload, because it is their document, not ours;
///   (ii)  the risk minimisation plan, developed IN CONSULTATION WITH the
///         family (hence `developedWithParentAt` — consultation is the part
///         that gets challenged, so the record has to carry its own proof);
///   (iii) the communication plan, which is how staff — including a casual
///         who has never met the child — find out, and how the family tells
///         us when things change.
///
/// One row per CONDITION, not per child: a child with asthma and a nut
/// allergy has two management plans from two practitioners and two very
/// different emergency responses. Collapsing them into one row is how a
/// service ends up giving Ventolin to an anaphylaxis.
model ChildMedicalPlan {
  id        String   @id @default(cuid())
  childId   String
  child     Child    @relation("ChildMedicalPlans", fields: [childId], references: [id], onDelete: Cascade)
  /// Denormalised from the child so the register can be listed and
  /// filtered per service without a join through Child on every read.
  /// Nullable because a child may sit between services mid-transfer.
  serviceId String?
  service   Service? @relation("ServiceMedicalPlans", fields: [serviceId], references: [id], onDelete: SetNull)

  /// anaphylaxis | asthma | diabetes | epilepsy | allergy | dietary |
  /// other. Drives the emergency-response template and the icon; free
  /// text is still accepted so an unusual condition is never blocked.
  conditionType String
  /// The specific condition as it should read on the medical wall:
  /// "Anaphylaxis — peanut and tree nut", not just "Anaphylaxis".
  condition     String
  /// mild | moderate | severe. Severe drives the red treatment on the
  /// roll-call card and the sign-in kiosk.
  severity      String @default("moderate")

  // ── Reg 90(1)(c)(i): the practitioner's plan ──────────────────────
  managementPlanUrl      String?
  managementPlanFileName String?
  /// The practitioner who signed it, and when. An ASCIA plan older than
  /// its review date is treated as expired, not merely stale.
  practitionerName       String?
  planIssuedDate         DateTime? @db.Date
  planExpiryDate         DateTime? @db.Date

  // ── Reg 90(1)(c)(ii): risk minimisation ───────────────────────────
  riskMinimisationPlan  String    @db.Text
  /// Reg 90(1)(c)(ii) requires this be developed in consultation with
  /// the family. Null means it has not been — which is a finding, so it
  /// is stored as an absent timestamp rather than a defaulted one.
  developedWithParentAt DateTime?

  // ── Reg 90(1)(c)(iii): communication ──────────────────────────────
  communicationPlan String @db.Text

  /// What to actually do, in order, when it happens. Held separately
  /// from the uploaded plan because a PDF in blob storage is no use to
  /// an educator holding a wheezing child.
  emergencyResponse String? @db.Text

  medicationRequired Boolean @default(false)
  /// Name, dose, route, where it is stored. Storage location is the
  /// detail people omit and the one that costs minutes in an emergency.
  medicationDetails  String? @db.Text
  medicationLocation String?

  /// Families sign to confirm the plan is current and correct. Same
  /// typed-name convention as ParentFormSignature.
  parentAcknowledgedAt    DateTime?
  parentAcknowledgedName  String?
  parentAcknowledgedEmail String?

  /// Reviewed at least annually, and after any incident. Nullable so an
  /// unreviewed plan is visibly unreviewed rather than silently due
  /// "now".
  reviewDueAt      DateTime? @db.Date
  lastReviewedAt   DateTime?
  lastReviewedById String?
  lastReviewedBy   User?     @relation("MedicalPlanReviewer", fields: [lastReviewedById], references: [id], onDelete: SetNull)

  /// active | archived. Archive rather than delete — a plan that was in
  /// force at the time of an incident has to remain readable afterwards.
  status String @default("active")

  createdById String?
  createdBy   User?    @relation("MedicalPlanCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([childId, status])
  @@index([serviceId, status])
  /// The two expiry sweeps: plans past their practitioner review date,
  /// and plans past our own annual review.
  @@index([serviceId, planExpiryDate])
  @@index([serviceId, reviewDueAt])
}

// ── Parent Posts (Staff-to-Parent Timeline) ─────────────────

model ParentPost {
  id          String         @id @default(cuid())
  serviceId   String
  service     Service        @relation("ServiceParentPosts", fields: [serviceId], references: [id], onDelete: Cascade)
  title       String
  content     String         @db.Text
  type        ParentPostType @default(observation)
  mediaUrls   String[] // Array of image/video URLs
  authorId    String?
  author      User?          @relation("PostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  isCommunity Boolean        @default(false) // If true, visible to all parents at the service. If false, only tagged children's parents.

  // ── Scheduling (2026-08-01) ──────────────────────────────────────────
  // draft | scheduled | published. Default "published" so every existing
  // row stays visible after the migration — the alternative would hide
  // every post already live.
  status    String    @default("published")
  // When the post becomes visible. Null = immediately.
  //
  // Visibility is evaluated at READ time (publishAt <= now) rather than
  // by a cron flipping a flag: a cron that fails or lags means a
  // scheduled post silently never appears, whereas a comparison can't
  // drift.
  publishAt DateTime?

  // ── Curriculum tagging ───────────────────────────────────────────────
  // MTOP, not EYLF — MTOP is the school-age framework, and offering both
  // invites tagging an OSHC post against the birth-to-five one.
  mtopOutcomes       String[] @default([])
  nqsAreas           String[] @default([])
  // Links to the program activities this post evidences.
  programActivityIds String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ── The planning cycle (2026-08-06) ──────────────────────────────────
  // A post can EXTEND an earlier one: you observed something, you did
  // something about it, and this is that. NQS Element 1.3 is the
  // assessment-and-planning cycle, and it's the element services most
  // often sit on "Working Towards" — not because nobody observes, but
  // because nothing shows what happened next.
  //
  // Self-relation rather than a join table: a follow-up extends exactly
  // one post, and the chain is read in both directions (what did this
  // come from / what came of it).
  extendsPostId String?
  extendsPost   ParentPost?  @relation("PostExtensions", fields: [extendsPostId], references: [id], onDelete: SetNull)
  extensions    ParentPost[] @relation("PostExtensions")

  tags     ParentPostChildTag[]
  likes    ParentPostLike[]
  comments ParentPostComment[]

  @@index([serviceId])
  @@index([extendsPostId])
  @@index([createdAt])
  @@index([status, publishAt])
}

model ParentPostChildTag {
  id      String     @id @default(cuid())
  postId  String
  post    ParentPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  childId String
  child   Child      @relation("ChildPostTags", fields: [childId], references: [id], onDelete: Cascade)

  @@unique([postId, childId])
  @@index([childId])
}

model ParentPostLike {
  id        String        @id @default(cuid())
  postId    String
  post      ParentPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  likerId   String
  liker     CentreContact @relation("ParentPostLikes", fields: [likerId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([postId, likerId])
  @@index([postId])
  @@index([likerId])
}

model ParentPostComment {
  id             String         @id @default(cuid())
  postId         String
  post           ParentPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentAuthorId String?
  parentAuthor   CentreContact? @relation("ParentPostComments", fields: [parentAuthorId], references: [id], onDelete: SetNull)
  staffAuthorId  String?
  staffAuthor    User?          @relation("ParentPostStaffComments", fields: [staffAuthorId], references: [id], onDelete: SetNull)
  body           String         @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([postId, createdAt])
  @@index([parentAuthorId])
  @@index([staffAuthorId])
}

// ── Parent Notifications (In-App Bell) ──────────────────

// ── Parent forms ───────────────────────────────────────────────────────
// Permission slips, policy acknowledgements, excursion consents — the
// paper a centre needs a family's signature on, without the paper.
model ParentForm {
  id          String    @id @default(cuid())
  serviceId   String
  service     Service   @relation("ServiceParentForms", fields: [serviceId], references: [id], onDelete: Cascade)
  title       String
  description String?   @db.Text
  /// The document itself (PDF or image in blob storage). Optional — an
  /// acknowledgement can be pure text ("I agree to the sun-safety policy").
  fileUrl     String?
  fileName    String?
  /// Signatures wanted by this date. Informational, not enforced.
  dueDate     DateTime? @db.Date
  /// One signature PER CHILD rather than per family. This is the CWA /
  /// medical-consent shape: "signed for Abdul" says nothing about his
  /// sister, so each child needs their own row.
  perChild    Boolean   @default(false)
  status      String    @default("active") // active | archived
  createdById String?
  createdBy   User?     @relation("ParentFormCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  signatures ParentFormSignature[]
  excursion  ServiceExcursion?     @relation("ExcursionForm")

  @@index([serviceId, status])
}

/// An excursion or incursion as a thing, not a form.
///
/// A permission slip is only half of it. Regulation 100-102 wants a risk
/// assessment written BEFORE the outing and reviewed, and the service
/// needs to know how many of the attending children have actually been
/// signed for. Holding those together is the whole point: an excursion
/// with 31 children and 8 signatures is a fact you want on one line,
/// not something you reconstruct from a form list the night before.
///
/// Permissions reuse ParentForm with `perChild: true` rather than a
/// second signature system — a signature is a signature, and the CWA
/// shape is already exactly right for "signed for Abdul, not Amira".
model ServiceExcursion {
  id          String       @id @default(cuid())
  serviceId   String
  service     Service      @relation("ServiceExcursions", fields: [serviceId], references: [id], onDelete: Cascade)
  /// excursion (they leave) | incursion (someone comes in). Different
  /// risk profiles, same paperwork shape.
  kind        String       @default("excursion")
  title       String
  /// Where they're going. Null for an incursion.
  destination String?
  date        DateTime     @db.Date
  /// The programme the outing belongs to, so attendance can be derived
  /// from that day's bookings rather than kept as a second list that
  /// drifts. SessionType, not free text.
  sessionType SessionType?
  /// Stage 1 dual key: the room this row belongs to, resolved from
  /// (serviceId, sessionType). Nullable while both keys are written —
  /// see docs/rooms-migration-plan.md.
  roomId      String?
  room        Room?        @relation("RoomServiceExcursion", fields: [roomId], references: [id], onDelete: SetNull)
  departTime  String? // "HH:mm"
  returnTime  String? // "HH:mm"
  transport   String? // "Walking", "Chartered bus"…
  notes       String?      @db.Text

  /// Reg 101: the written risk assessment, and evidence someone senior
  /// actually read it. Reviewed is a separate act from uploading.
  riskAssessmentUrl          String?
  riskAssessmentFileName     String?
  riskAssessmentReviewedAt   DateTime?
  riskAssessmentReviewedById String?
  riskAssessmentReviewedBy   User?     @relation("ExcursionRiskReviewer", fields: [riskAssessmentReviewedById], references: [id], onDelete: SetNull)

  /// The permission slip families sign. Optional only because an
  /// incursion sometimes needs none.
  formId String?     @unique
  form   ParentForm? @relation("ExcursionForm", fields: [formId], references: [id], onDelete: SetNull)

  headcounts ServiceHeadcount[] @relation("ExcursionHeadcounts")

  status      String   @default("planned") // planned | completed | cancelled
  createdById String?
  createdBy   User?    @relation("ExcursionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([serviceId, date])
  @@index([serviceId, status])
}

/// A headcount or an evacuation drill.
///
/// Reg 168(2)(e) wants emergency evacuation rehearsed and recorded, and
/// on an OSHC service a headcount is the routine act that catches a
/// child who walked to the wrong gate. Both are the same shape: a moment
/// in time, who was counted, and who says the count was right.
///
/// Counting STAFF and VISITORS as well as children is the part people
/// skip and regulators ask about — an evacuation record that only counts
/// children can't prove the building was cleared.
model ServiceHeadcount {
  id          String            @id @default(cuid())
  serviceId   String
  service     Service           @relation("ServiceHeadcounts", fields: [serviceId], references: [id], onDelete: Cascade)
  /// head_count | evacuation_drill | excursion_head_count | bus_run
  kind        String            @default("head_count")
  conductedAt DateTime          @default(now())
  /// The programme running at the time, when there is one.
  sessionType SessionType?
  /// Stage 1 dual key: the room this row belongs to, resolved from
  /// (serviceId, sessionType). Nullable while both keys are written —
  /// see docs/rooms-migration-plan.md.
  roomId      String?
  room        Room?             @relation("RoomServiceHeadcount", fields: [roomId], references: [id], onDelete: SetNull)
  /// Set when this count belongs to an outing, so an excursion can show
  /// its own counts rather than them floating loose in the register.
  excursionId String?
  excursion   ServiceExcursion? @relation("ExcursionHeadcounts", fields: [excursionId], references: [id], onDelete: SetNull)

  childrenCount Int
  staffCount    Int      @default(0)
  visitorsCount Int      @default(0)
  /// Who was counted, when the counter went child-by-child. Optional: a
  /// quick gate count is a number, and pretending otherwise would push
  /// people to skip recording it at all.
  childIds      String[] @default([])

  /// Drills only: how long the building took to clear, and what went
  /// wrong. "Nothing" is a valid answer; null means nobody said.
  evacuationSeconds Int?
  issuesIdentified  String? @db.Text
  notes             String? @db.Text

  conductedById String?
  conductedBy   User?     @relation("HeadcountConductor", fields: [conductedById], references: [id], onDelete: SetNull)
  /// Countersigned by someone senior. A drill nobody reviewed is a drill
  /// that taught nobody anything.
  signedOffAt   DateTime?
  signedOffById String?
  signedOffBy   User?     @relation("HeadcountSignOff", fields: [signedOffById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([serviceId, conductedAt])
  @@index([serviceId, kind])
  @@index([excursionId])
}

/// Who came into the service, and when they left.
///
/// Reg 165-166: the service must know who is on the premises. It is also
/// the register that makes a headcount honest — "23 children, 3 staff,
/// 1 visitor" is only checkable if the visitor signed in somewhere.
///
/// Signed out is nullable on purpose: someone still in the building is
/// the normal state, and it's what the "still on site" list is built
/// from at close.
model ServiceVisitor {
  id           String    @id @default(cuid())
  serviceId    String
  service      Service   @relation("ServiceVisitors", fields: [serviceId], references: [id], onDelete: Cascade)
  name         String
  organisation String?
  /// Why they're here: contractor, parent tour, regulator, maintenance…
  purpose      String?
  /// Who they're here to see.
  visitingWhom String?
  phone        String?
  signedInAt   DateTime  @default(now())
  signedOutAt  DateTime?
  /// Recorded when a visitor's WWCC was sighted at the door. Null means
  /// nobody checked — which is different from "they don't have one".
  wwccSighted  Boolean   @default(false)
  wwccNumber   String?
  notes        String?   @db.Text
  recordedById String?
  recordedBy   User?     @relation("VisitorRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())

  @@index([serviceId, signedInAt])
  @@index([serviceId, signedOutAt])
}

/// A staff injury or near-miss. Deliberately separate from
/// IncidentRecord, which is about children: the fields differ (workers
/// compensation, body part, treatment) and mixing them makes both
/// registers harder to read and to report from.
model StaffIncidentReport {
  id                    String    @id @default(cuid())
  serviceId             String
  service               Service   @relation("ServiceStaffIncidents", fields: [serviceId], references: [id], onDelete: Cascade)
  /// The person hurt. Nullable so a casual or contractor can be recorded
  /// by name without an account.
  userId                String?
  user                  User?     @relation("StaffIncidentSubject", fields: [userId], references: [id], onDelete: SetNull)
  staffName             String
  occurredAt            DateTime
  /// injury | near_miss | illness | property | other
  incidentType          String    @default("injury")
  severity              String    @default("minor") // minor | moderate | serious | notifiable
  location              String?
  description           String    @db.Text
  bodyPart              String?
  treatment             String?   @db.Text
  witnessNames          String?
  /// SafeWork and the like. A notifiable incident that was never
  /// notified is the thing this flag exists to make visible.
  reportableToAuthority Boolean   @default(false)
  reportedToAuthorityAt DateTime?
  workersCompClaim      Boolean   @default(false)
  followUpRequired      Boolean   @default(false)
  followUpCompleted     Boolean   @default(false)
  followUpNotes         String?   @db.Text

  reportedById  String?
  reportedBy    User?     @relation("StaffIncidentReporter", fields: [reportedById], references: [id], onDelete: SetNull)
  signedOffAt   DateTime?
  signedOffById String?
  signedOffBy   User?     @relation("StaffIncidentSignOff", fields: [signedOffById], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([serviceId, occurredAt])
  @@index([serviceId, severity])
}

/// Illness and infectious disease.
///
/// Reg 88: when a child has an infectious disease the service must
/// notify families. Recording the case and the notification together is
/// the point — an outbreak where nobody can show when parents were told
/// is the situation this prevents.
model IllnessRecord {
  id                  String    @id @default(cuid())
  serviceId           String
  service             Service   @relation("ServiceIllnessRecords", fields: [serviceId], references: [id], onDelete: Cascade)
  childId             String?
  child               Child?    @relation("ChildIllnessRecords", fields: [childId], references: [id], onDelete: SetNull)
  /// Kept alongside childId so a record survives a child leaving.
  personName          String
  /// child | staff — staff illness matters for exclusion periods too.
  personType          String    @default("child")
  illness             String
  /// True for the notifiable list (gastro, hand foot and mouth, measles…).
  infectious          Boolean   @default(false)
  onsetDate           DateTime  @db.Date
  excludedFrom        DateTime? @db.Date
  /// When they may return. The date staff are actually asked for.
  returnDate          DateTime? @db.Date
  symptoms            String?   @db.Text
  actionTaken         String?   @db.Text
  /// Families told, and when. Reg 88's whole point.
  familiesNotifiedAt  DateTime?
  notifiedById        String?
  notifiedBy          User?     @relation("IllnessNotifier", fields: [notifiedById], references: [id], onDelete: SetNull)
  /// Public health unit, where the disease requires it.
  authorityNotifiedAt DateTime?
  notes               String?   @db.Text
  recordedById        String?
  recordedBy          User?     @relation("IllnessRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([serviceId, onsetDate])
  @@index([serviceId, infectious])
}

/// The complaints and feedback register — Reg 168(2)(o) and, the sharp
/// end, section 174(2)(b) of the National Law.
///
/// The dashboard had `incidentType: "complaint"` and a staff-performance
/// case file, and neither is the register. A complaint about fees and a
/// complaint alleging a child was left unsupervised are the same intake
/// form and completely different legal objects: the second one starts a
/// 24-HOUR clock to notify the Regulatory Authority, and missing it is an
/// offence regardless of whether the allegation turns out to be true.
///
/// So `notifiable` is asked at intake, not derived at review — the person
/// taking the phone call is the one who knows what was alleged, and by
/// the time a manager triages it the next morning a third of the window
/// is gone. `notificationDueAt` is stamped from `becameAwareAt` at write
/// time rather than computed on read, so the deadline cannot silently
/// move when someone corrects the date the complaint was received.
///
/// Note the two independent outcomes: `outcome` is what we tell the
/// complainant, `investigationNotes` is what we write for ourselves.
/// Merging them is how internal notes end up quoted back at a service.
model ComplaintRecord {
  id        String  @id @default(cuid())
  serviceId String
  service   Service @relation("ServiceComplaints", fields: [serviceId], references: [id], onDelete: Cascade)
  /// Human reference for correspondence — CMP-2026-0001. Sequential per
  /// year, minted the same way as the creative-request number.
  reference String  @unique

  receivedAt DateTime @default(now())
  /// parent_portal | phone | email | in_person | letter | staff | anonymous.
  /// A complaint received anonymously is still a notifiable complaint,
  /// which is why anonymity is a source and not a reason to skip intake.
  source     String   @default("in_person")

  complainantName  String?
  complainantEmail String?
  complainantPhone String?
  anonymous        Boolean @default(false)

  childId   String?
  child     Child?  @relation("ChildComplaints", fields: [childId], references: [id], onDelete: SetNull)
  childName String?

  /// fee | staff_conduct | child_safety | supervision | food | program |
  /// communication | facilities | other.
  category String
  summary  String  @db.Text
  details  String? @db.Text

  // ── s.174(2)(b) / Reg 176(2)(b): the 24-hour clock ────────────────
  /// True when the complaint ALLEGES either that a serious incident has
  /// occurred, or that the Law/Regulations have been contravened.
  notifiable          Boolean   @default(false)
  /// serious_incident | law_contravention — s.174(2)(b)(i) and (ii).
  notifiableReason    String?
  /// When the service became aware. The clock runs from here, not from
  /// when the complaint was written or logged.
  becameAwareAt       DateTime?
  /// Stamped at write time from becameAwareAt + 24h. Stored so an
  /// overdue notification stays overdue in the register even if someone
  /// later edits the awareness date.
  notificationDueAt   DateTime?
  regulatorNotifiedAt DateTime?
  /// NQA ITS reference for the lodged notification.
  regulatorReference  String?

  // ── Handling ──────────────────────────────────────────────────────
  /// new | acknowledged | investigating | resolved | closed | escalated
  status         String    @default("new")
  assignedToId   String?
  assignedTo     User?     @relation("ComplaintAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  /// Receipt confirmed to the complainant — the first thing a family
  /// asks about and the first thing a service forgets.
  acknowledgedAt DateTime?

  /// Internal. Never shown to the complainant, never returned on the
  /// parent-facing endpoint.
  investigationNotes String?   @db.Text
  /// What the complainant is told. Safe to surface in the portal.
  outcome            String?   @db.Text
  resolvedAt         DateTime?
  resolvedById       String?
  resolvedBy         User?     @relation("ComplaintResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  /// Set for complaints raised through the parent portal, so the family
  /// can follow their own one. Portal-raised complaints carry the
  /// submitting parent's email; matching on it is what scopes the read.
  parentVisible Boolean @default(false)

  createdById String?
  createdBy   User?    @relation("ComplaintCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([serviceId, status])
  @@index([serviceId, receivedAt])
  /// The overdue-notification sweep.
  @@index([notifiable, regulatorNotifiedAt])
  @@index([complainantEmail, parentVisible])
}

/// A date a room (or the whole centre) isn't running.
///
/// Pupil-free days, centre closures, a vacation-care day that's already
/// full by design. Without this, a coordinator's only options are to
/// switch casual bookings off entirely — which closes every other day
/// too — or to let families book a day nobody will be there.
///
/// sessionType null = the whole centre is closed that day.
model ServiceBlockOutDate {
  id          String       @id @default(cuid())
  serviceId   String
  service     Service      @relation("ServiceBlockOutDates", fields: [serviceId], references: [id], onDelete: Cascade)
  date        DateTime     @db.Date
  sessionType SessionType?
  /// Stage 1 dual key: the room this row belongs to, resolved from
  /// (serviceId, sessionType). Nullable while both keys are written —
  /// see docs/rooms-migration-plan.md.
  roomId      String?
  room        Room?        @relation("RoomServiceBlockOutDate", fields: [roomId], references: [id], onDelete: SetNull)
  /// Shown to families when a booking is refused, so the answer is
  /// "we're closed for the pupil-free day", not "unavailable".
  reason      String?
  createdById String?
  createdBy   User?        @relation("BlockOutDateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())

  @@index([serviceId, date])
}

/// A window of care this centre sells — the "session of care" catalogue.
///
/// Modelled on OWNA's Service Info → Session Times, and it exists for the
/// reason theirs does: every fee in every room has to name a window, and
/// before this the window was typed freehand onto each fee. Six rooms
/// meant six chances to type 15:00–18:30 as 15:00–18:00, and the number
/// that drifts is the one reported to CCS as the session of care.
///
/// The catalogue is centre-level and the rooms point AT it, not the
/// other way round. A centre runs one 3.5-hour afternoon session; which
/// rooms sell it is a separate question from what the session is.
///
/// Deliberately NOT the same thing as `Service.sessionTimes`, which holds
/// the fixed bsc/asc/vc room definitions. That field is the room list;
/// this table is the hours. They will converge when rooms become
/// first-class records rather than seven fixed enum slots.
model ServiceSessionTime {
  id        String  @id @default(cuid())
  serviceId String
  service   Service @relation("ServiceSessionTimes", fields: [serviceId], references: [id], onDelete: Cascade)

  /// Wall-clock "HH:mm" in the centre's local time. Opening hours, not
  /// instants — 15:00 is three in the afternoon through daylight saving
  /// in both directions, and storing these as timestamps would be wrong
  /// twice a year.
  start String
  end   String

  /// Optional name. Most centres think in times and leave this blank;
  /// the ones that don't have a reason ("Ramadan Care") and that reason
  /// is what they'll search the dropdown for.
  label String?

  /// Retired without being deleted. Fees already reference this window,
  /// and a historical fee has to keep reading correctly — so retiring
  /// hides it from new fees rather than orphaning old ones.
  active Boolean @default(true)

  createdById String?
  createdBy   User?    @relation("SessionTimeCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// The same window twice is always a mistake, and two identical rows
  /// in the dropdown is the kind of thing nobody reports and everybody
  /// works around.
  @@unique([serviceId, start, end])
  @@index([serviceId, active])
}

/// Which fee a child is charged at, in one room.
///
/// This is the link the fees matrix was missing. A `Booking` records the
/// child, the date and the ROOM — it has never recorded which of that
/// room's fees applies. So in a room running four fees (recurring,
/// casual, Wednesday care, Ramadan care) there was no way to answer
/// "how many children are on this rate", and no way to charge two
/// children in the same room differently.
///
/// One row per child per room, enforced by the unique below. A child
/// attending both before- and after-school care has two rows, because
/// those are two rooms with two fee lists — but they cannot be on two
/// fees for the SAME room at once, which is the mistake this prevents.
///
/// `feeTierId` points into the room's `fees` array in
/// `Service.sessionTimes` rather than at a table, because that is where
/// fee tiers live. `feeName` is denormalised beside it so the assignment
/// still reads correctly after a tier is renamed or archived — a row
/// saying "fee-3" answers nothing when a parent rings about their
/// invoice.
/// A room at a centre, as a record rather than an enum slot.
///
/// Rooms are currently seven fixed slots baked into `SessionType` —
/// `bsc`, `asc`, `vc` and four generic spares — with their definitions
/// living as JSON on `Service.sessionTimes`. A centre cannot add an
/// eighth without a schema change, a room cannot own a roll, and
/// educators cannot be assigned to one.
///
/// STAGE 0 of the migration in docs/rooms-migration-plan.md: this table
/// is a SHADOW. It is written by `syncRoomsFromSessionTimes` whenever
/// the JSON changes, and nothing reads it yet. That is deliberate — it
/// lets the backfill run, be checked against the JSON, and be corrected,
/// while the app carries on reading the JSON exactly as before. Dropping
/// this table today would change no behaviour.
///
/// `legacyKey` is the join back to the enum, and is kept FOREVER. It is
/// how every later dual-write reconciles, and once the enum columns are
/// dropped it is the only record of what a historical row meant.
model Room {
  id        String  @id @default(cuid())
  serviceId String
  service   Service @relation("ServiceRooms", fields: [serviceId], references: [id], onDelete: Cascade)

  /// What this centre calls the room. Not globally unique — two centres
  /// each having a "Rise and Shine" is normal, not a conflict.
  name String

  /// The `SessionType` slot this room was created from. Nullable because
  /// a room added AFTER the enum is retired has no legacy slot; every
  /// row created by the Stage 0 backfill has one.
  legacyKey SessionType?

  /// Opening hours, "HH:MM". Strings rather than DateTime: these are
  /// wall-clock times of day with no date, and storing them as
  /// timestamps invites a timezone to be applied to something that
  /// doesn't have one.
  startTime String?
  endTime   String?

  capacity    Int?
  /// Minimum educator:child ratio, "1:15" style. Null means the service
  /// default applies — a room must not silently carry a looser ratio
  /// than the service it sits in.
  ratio       String?
  description String? @db.Text
  /// Age range in whole YEARS. School-age care talks in school years,
  /// not months.
  minAgeYears Int?
  maxAgeYears Int?
  photoUrl    String?

  /// A room children can't be booked into — a staff room, an office. It
  /// still exists for rostering and ratios.
  staffOnly Boolean @default(false)

  /// Retired, not deleted. A room with historical attendance can never
  /// be removed without orphaning those records, so retiring is the only
  /// way out. Timestamped rather than a boolean: "when did this room
  /// close" is a question that gets asked.
  archivedAt DateTime?

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One room per enum slot per service — this is what makes the
  /// backfill idempotent and the resolver unambiguous. Rooms added later
  /// with a null `legacyKey` are exempt, since Postgres treats NULLs as
  /// distinct in a unique index, which is exactly what an unlimited
  /// number of new rooms needs.
  /// Stage 1 back-relations. Nothing reads these yet; they exist so the
  /// dual-written foreign keys are declared on both sides.
  absences                Absence[]                @relation("RoomAbsence")
  attendanceRecords       AttendanceRecord[]       @relation("RoomAttendanceRecord")
  bookings                Booking[]                @relation("RoomBooking")
  bookingForecasts        BookingForecast[]        @relation("RoomBookingForecast")
  casualDayConfigs        CasualDayConfig[]        @relation("RoomCasualDayConfig")
  childFeeAssignments     ChildFeeAssignment[]     @relation("RoomChildFeeAssignment")
  conversionOpportunitys  ConversionOpportunity[]  @relation("RoomConversionOpportunity")
  dailyAttendances        DailyAttendance[]        @relation("RoomDailyAttendance")
  dailyChecklists         DailyChecklist[]         @relation("RoomDailyChecklist")
  familyDiscounts         FamilyDiscount[]         @relation("RoomFamilyDiscount")
  responsiblePersonEntrys ResponsiblePersonEntry[] @relation("RoomResponsiblePersonEntry")
  rosterShifts            RosterShift[]            @relation("RoomRosterShift")
  serviceBlockOutDates    ServiceBlockOutDate[]    @relation("RoomServiceBlockOutDate")
  serviceExcursions       ServiceExcursion[]       @relation("RoomServiceExcursion")
  serviceFeeChanges       ServiceFeeChange[]       @relation("RoomServiceFeeChange")
  serviceHeadcounts       ServiceHeadcount[]       @relation("RoomServiceHeadcount")
  shiftTemplates          ShiftTemplate[]          @relation("RoomShiftTemplate")
  statementLineItems      StatementLineItem[]      @relation("RoomStatementLineItem")

  @@unique([serviceId, legacyKey])
  @@index([serviceId, archivedAt])
}

model ChildFeeAssignment {
  id        String  @id @default(cuid())
  childId   String
  child     Child   @relation("ChildFeeAssignments", fields: [childId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service @relation("ServiceFeeAssignments", fields: [serviceId], references: [id], onDelete: Cascade)

  /// The room. Same enum every Booking and AttendanceRecord uses.
  sessionType SessionType
  /// Stage 1 dual key: the room this row belongs to, resolved from
  /// (serviceId, sessionType). Nullable while both keys are written —
  /// see docs/rooms-migration-plan.md.
  roomId      String
  room        Room       @relation("RoomChildFeeAssignment", fields: [roomId], references: [id], onDelete: Restrict)
  /// The tier's id within that room's `fees` array.
  feeTierId   String
  /// Denormalised at write time; see the note above.
  feeName     String

  /// When this rate starts applying to this child. Null means "now, and
  /// we didn't record a date" — which is the honest answer for an
  /// assignment made mid-term rather than a back-dated one.
  effectiveFrom DateTime? @db.Date

  createdById String?
  createdBy   User?    @relation("FeeAssignmentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// One fee per child per room.
  @@unique([childId, sessionType])
  /// Stage 1 parallel unique. Held AT THE SAME TIME as the
  /// sessionType one above — a resolver bug then fails the write
  /// instead of diverging quietly.
  @@unique([childId, roomId], map: "ChildFeeAssignment_roomId_unique_idx")
  /// The "Applied To" count: group by tier within a service and room.
  @@index([serviceId, sessionType, feeTierId])
  @@index([feeTierId])
}

/// A change to a room's fee — scheduled for a date, or already applied.
///
/// Two jobs in one table, deliberately. A centre raising fees decides in
/// July that the rate changes in August; without this they write it in a
/// calendar and do it by hand on the day, which is how a fee rise gets
/// missed or applied a fortnight early. And every applied change leaves
/// a row, so "who put the rate up, and when" has an answer — the
/// question that arrives when a family disputes an invoice.
///
/// Fees themselves stay in Service.sessionTimes JSON. This table is the
/// intent and the history, not the current price.
model ServiceFeeChange {
  id          String      @id @default(cuid())
  serviceId   String
  service     Service     @relation("ServiceFeeChanges", fields: [serviceId], references: [id], onDelete: Cascade)
  /// Which room the fee belongs to.
  sessionType SessionType
  /// Stage 1 dual key: the room this row belongs to, resolved from
  /// (serviceId, sessionType). Nullable while both keys are written —
  /// see docs/rooms-migration-plan.md.
  roomId      String
  room        Room       @relation("RoomServiceFeeChange", fields: [roomId], references: [id], onDelete: Restrict)
  /// The fee tier's id within that room's `fees` array.
  feeTierId   String
  /// Denormalised so history stays readable after a fee is renamed or
  /// deleted. A history row that says "fee-3" answers nothing.
  feeName     String

  /// What it was, and what it becomes. Nullable "from" because a
  /// scheduled change recorded before the first rate exists is possible.
  fromAmountCents Int?
  toAmountCents   Int
  fromCasualCents Int?
  toCasualCents   Int?
  fromStaffCents  Int?
  toStaffCents    Int?

  /// The day the new rate starts. For an immediate edit this is today
  /// and the row is written already applied.
  effectiveDate DateTime  @db.Date
  /// scheduled | applied | cancelled
  status        String    @default("scheduled")
  appliedAt     DateTime?

  createdById String?
  createdBy   User?    @relation("FeeChangeCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  note        String?

  @@index([serviceId, status, effectiveDate])
  @@index([serviceId, sessionType])
}

/// A record that someone chased a family about money.
///
/// Aged debtors could show who owed what, but not whether anyone had
/// actually rung them — so the same family got chased twice in a week
/// while another sat at 90 days untouched. "Nobody has contacted this
/// family" is the most useful filter on a debtors list, and it needs a
/// place for the contact to be written down.
///
/// Separate from Statement.notes because this is about the CHASE, not
/// the invoice: one debt takes several calls, and each is its own event.
model FamilyDebtContact {
  id          String        @id @default(cuid())
  contactId   String
  contact     CentreContact @relation("ContactDebtChases", fields: [contactId], references: [id], onDelete: Cascade)
  contactedAt DateTime      @default(now())
  /// call | email | sms | in_person | letter
  method      String
  /// What came of it — a payment plan, a promise, no answer.
  outcome     String?
  note        String?       @db.Text
  byId        String?
  by          User?         @relation("DebtChaser", fields: [byId], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())

  @@index([contactId, contactedAt])
}

/// A single day's casual capacity for one room, where it differs from
/// the room's standing configuration.
///
/// OWNA materialises every casual SPOT as a row — twenty rows for twenty
/// seats, generated a fortnight ahead by a job. That makes the grid easy
/// and everything else hard: thousands of rows a term, a generator that
/// can fall behind, and a booking that has to claim a specific seat.
///
/// A day only needs a COUNT and a switch. Which seats are taken comes
/// from the bookings that already exist, so the two can never disagree
/// and there's nothing to generate.
///
/// A row here exists only when a day differs from the default — most
/// days have none.
model CasualDayConfig {
  id          String      @id @default(cuid())
  serviceId   String
  service     Service     @relation("ServiceCasualDays", fields: [serviceId], references: [id], onDelete: Cascade)
  date        DateTime    @db.Date
  sessionType SessionType
  /// Stage 1 dual key: the room this row belongs to, resolved from
  /// (serviceId, sessionType). Nullable while both keys are written —
  /// see docs/rooms-migration-plan.md.
  roomId      String
  room        Room       @relation("RoomCasualDayConfig", fields: [roomId], references: [id], onDelete: Restrict)
  /// Spots for this day. Null means "use the room's usual number".
  spots       Int?
  /// Open the day for staff to fill without letting families book it —
  /// the vacation-care day you're holding for siblings, or a day you
  /// haven't announced yet.
  closed      Boolean     @default(false)
  note        String?
  createdById String?
  createdBy   User?       @relation("CasualDayCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([serviceId, date, sessionType])

  /// Stage 1 parallel unique. Held AT THE SAME TIME as the

  /// sessionType one above — a resolver bug then fails the write

  /// instead of diverging quietly.

  @@unique([roomId, date], map: "CasualDayConfig_roomId_unique_idx")
  @@index([serviceId, date])
}

/// A standing discount on what a family pays.
///
/// Sibling arrangements, staff rates, hardship. OWNA calls the nearest
/// thing "Room Discount" and hangs it off the room; that models the
/// wrong noun. A discount belongs to a FAMILY — it follows them across
/// rooms, it survives a fee rise, and it ends on a date. Hanging it off
/// the room means re-applying it every time the fee matrix changes.
///
/// Scoped to one room when it needs to be (a staff rate that only
/// applies to after-school care), otherwise every room.
model FamilyDiscount {
  id          String        @id @default(cuid())
  contactId   String
  contact     CentreContact @relation("ContactDiscounts", fields: [contactId], references: [id], onDelete: Cascade)
  serviceId   String
  service     Service       @relation("ServiceDiscounts", fields: [serviceId], references: [id], onDelete: Cascade)
  /// Null = every room at this service.
  sessionType SessionType?
  /// Stage 1 dual key: the room this row belongs to, resolved from
  /// (serviceId, sessionType). Nullable while both keys are written —
  /// see docs/rooms-migration-plan.md.
  roomId      String?
  room        Room?         @relation("RoomFamilyDiscount", fields: [roomId], references: [id], onDelete: SetNull)
  /// Set when the arrangement is for ONE child rather than the whole
  /// family. A staff member's own child gets the staff rate; their
  /// siblings might not. Null = every child in the family.
  childId     String?
  child       Child?        @relation("ChildDiscounts", fields: [childId], references: [id], onDelete: Cascade)
  /// percent | amount
  kind        String
  /// Percent (1–100) or cents off, depending on `kind`.
  value       Int
  /// Why, in a word or two — it ends up on the family's billing.
  reason      String
  startDate   DateTime      @db.Date
  /// Open-ended when null. A sibling discount runs until it doesn't.
  endDate     DateTime?     @db.Date
  createdById String?
  createdBy   User?         @relation("DiscountCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([contactId, startDate])
  @@index([serviceId])
}

model ParentFormSignature {
  id          String     @id @default(cuid())
  formId      String
  form        ParentForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  /// The signing convention the enrolment form already uses: a typed
  /// full name, stored with the moment it was given.
  parentEmail String
  signedName  String
  /// Set when the form is per-child (CWA, medical consent). Null for a
  /// family-level form. Uniqueness lives in two PARTIAL indexes in SQL —
  /// a plain composite unique treats NULLs as distinct and would allow
  /// double family signatures — so the model carries no @@unique and the
  /// API checks before creating.
  childId     String?
  child       Child?     @relation("ChildFormSignatures", fields: [childId], references: [id], onDelete: Cascade)
  signedAt    DateTime   @default(now())

  @@index([formId, parentEmail])
  @@index([parentEmail])
}

model ParentNotification {
  id          String   @id @default(cuid())
  parentEmail String
  type        String // post, booking, message, attendance
  title       String
  body        String
  link        String // deep link path e.g. "/parent/messages/abc123"
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([parentEmail, read])
  @@index([parentEmail, createdAt])
}

