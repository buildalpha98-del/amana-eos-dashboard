}

model Rock {
  id              String       @id @default(cuid())
  title           String
  description     String?      @db.Text
  ownerId         String?
  owner           User?        @relation("RockOwner", fields: [ownerId], references: [id])
  quarter         String
  status          RockStatus   @default(on_track)
  percentComplete Int          @default(0)
  priority        RockPriority @default(medium)
  rockType        RockType     @default(personal)
  oneYearGoalId   String?
  oneYearGoal     OneYearGoal? @relation(fields: [oneYearGoalId], references: [id], onDelete: SetNull)
  serviceId       String?
  service         Service?     @relation("ServiceRocks", fields: [serviceId], references: [id], onDelete: SetNull)
  deleted         Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  todos       Todo[]
  issues      Issue[]
  milestones  Milestone[]
  measurables Measurable[]
  projects    Project[]     @relation("RockProjects")
  attachments Attachment[]

  @@index([quarter])
  @@index([ownerId])
  @@index([status])
  @@index([serviceId])
  @@index([quarter, serviceId])
  @@index([quarter, ownerId])
  @@index([quarter, status])
}

model Milestone {
  id        String   @id @default(cuid())
  title     String
  dueDate   DateTime
  completed Boolean  @default(false)
  rockId    String
  rock      Rock     @relation(fields: [rockId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Todo {
  id          String     @id @default(cuid())
  title       String
  description String?    @db.Text
  assigneeId  String?
  assignee    User?      @relation("TodoAssignee", fields: [assigneeId], references: [id])
  createdById String?
  createdBy   User?      @relation("TodoCreator", fields: [createdById], references: [id])
  rockId      String?
  rock        Rock?      @relation(fields: [rockId], references: [id], onDelete: SetNull)
  issueId     String?
  issue       Issue?     @relation(fields: [issueId], references: [id], onDelete: SetNull)
  serviceId   String?
  service     Service?   @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  projectId   String?
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  // 2026-07-08: correlates a survey-generated todo with its source
  // Survey so the response-submit endpoint can auto-complete the
  // todo when the user submits. Populated only for todos created
  // by /api/surveys/[id]/publish; null for every other todo.
  surveyId    String?
  survey      Survey?    @relation("SurveyTodos", fields: [surveyId], references: [id], onDelete: SetNull)
  // 2026-08-31: meeting this todo was created in (IDS create-todo,
  // To-Do Review quick-add). SetNull so deleting a mis-started meeting
  // never destroys todos.
  meetingId   String?
  meeting     Meeting?   @relation("MeetingTodos", fields: [meetingId], references: [id], onDelete: SetNull)
  dueDate     DateTime
  status      TodoStatus @default(pending)
  weekOf      DateTime
  isPrivate   Boolean    @default(false)
  /// Optional outcome note recorded when the todo is completed; cleared
  /// server-side if the todo is re-opened (2026-08-31).
  completionNote String? @db.Text
  deleted     Boolean    @default(false)
  createdAt   DateTime   @default(now())
  completedAt DateTime?
  updatedAt   DateTime   @updatedAt

  assignees             TodoAssignee[]        @relation("TodoAssignees")
  aiDrafts              AiTaskDraft[]         @relation("TodoAiDraft")
  sourceCall            VapiCall?             @relation("TodoFromCall")
  // 2026-07-23: reverse side of FamilyBalanceContact.followUpTodo.
  // Only populated when the parent contact had outcome=no_answer
  // and the endpoint auto-generated a follow-up.
  familyContactFollowUp FamilyBalanceContact? @relation("FamilyContactFollowUp")

  @@index([assigneeId])
  @@index([rockId])
  @@index([weekOf])
  @@index([status])
  @@index([serviceId])
  @@index([projectId])
  @@index([createdById])
  @@index([weekOf, serviceId])
  @@index([assigneeId, status])
  @@index([dueDate, status])
  @@index([meetingId])
}

model TodoAssignee {
  id     String @id @default(cuid())
  todoId String
  todo   Todo   @relation("TodoAssignees", fields: [todoId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation("TodoMultiAssignee", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([todoId, userId])
  @@index([todoId])
  @@index([userId])
}

model Issue {
  id           String        @id @default(cuid())
  title        String
  description  String?       @db.Text
  raisedById   String?
  raisedBy     User?         @relation("IssueRaiser", fields: [raisedById], references: [id])
  ownerId      String?
  owner        User?         @relation("IssueOwner", fields: [ownerId], references: [id])
  rockId       String?
  rock         Rock?         @relation(fields: [rockId], references: [id], onDelete: SetNull)
  // 2026-08-31: the off-track measurable this issue polices (scorecard
  // watchdog). SetNull — deleting a measurable keeps discussion history.
  measurableId String?
  measurable   Measurable?   @relation(fields: [measurableId], references: [id], onDelete: SetNull)
  serviceId    String?
  service      Service?      @relation("ServiceIssues", fields: [serviceId], references: [id], onDelete: SetNull)
  priority     IssuePriority @default(medium)
  status       IssueStatus   @default(open)
  category     IssueCategory @default(short_term)
  identifiedAt DateTime      @default(now())
  discussedAt  DateTime?
  solvedAt     DateTime?
  resolution   String?       @db.Text
  deleted      Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  spawnedTodos Todo[]
  attachments  Attachment[]
  aiDrafts     AiTaskDraft[] @relation("IssueAiDraft")

  @@index([priority])
  @@index([status])
  @@index([ownerId])
  @@index([serviceId])
  @@index([raisedById])
  @@index([status, serviceId])
  @@index([status, priority])
  @@index([ownerId, status])
  @@index([category])
  @@index([category, status])
  @@index([measurableId])
}

model Scorecard {
  id        String   @id @default(cuid())
  title     String
  // 2026-05-12 (Bucket O Stage 1): scorecards are now first-class
  // entities with an owner + invited members. Existing rows backfilled
  // to the first owner-role user. New scorecards record their creator
  // as owner; the owner controls renaming + membership.
  ownerId   String
  owner     User     @relation("ScorecardOwner", fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  measurables Measurable[]
  members     ScorecardMember[]

  @@index([ownerId])
}

/// Per-scorecard membership. Members can view the scorecard and own
/// measurables within it. The scorecard's `owner` is implicitly also
/// a member but not stored here — permission checks add the owner
/// in code. ON DELETE CASCADE on both FKs so deleting a scorecard or
/// user cleans up memberships.
model ScorecardMember {
  id          String    @id @default(cuid())
  scorecardId String
  scorecard   Scorecard @relation(fields: [scorecardId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation("ScorecardMembership", fields: [userId], references: [id], onDelete: Cascade)
  addedAt     DateTime  @default(now())

  @@unique([scorecardId, userId])
  @@index([userId])
  @@index([scorecardId])
}

model Measurable {
  id            String              @id @default(cuid())
  title         String
  description   String?
  ownerId       String?
  owner         User?               @relation("MeasurableOwner", fields: [ownerId], references: [id])
  goalValue     Float
  goalDirection GoalDirection       @default(above)
  unit          String?
  frequency     MeasurableFrequency @default(weekly)
  sortOrder     Int                 @default(0)
  rockId        String?
  rock          Rock?               @relation(fields: [rockId], references: [id], onDelete: SetNull)
  scorecardId   String
  scorecard     Scorecard           @relation(fields: [scorecardId], references: [id], onDelete: Cascade)
  serviceId     String?
  service       Service?            @relation("ServiceMeasurables", fields: [serviceId], references: [id], onDelete: SetNull)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  entries MeasurableEntry[]
  issues  Issue[]

  @@index([ownerId])
  @@index([scorecardId])
  @@index([serviceId])
}

model MeasurableEntry {
  id           String     @id @default(cuid())
  measurableId String
  measurable   Measurable @relation(fields: [measurableId], references: [id], onDelete: Cascade)
  weekOf       DateTime
  value        Float
  onTrack      Boolean
  notes        String?
  enteredById  String?
  enteredBy    User?      @relation("EntryCreator", fields: [enteredById], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([measurableId, weekOf])
  @@index([weekOf])
  @@index([enteredById])
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  details    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@index([userId, createdAt])
}

